# Senha única de acesso. Trocar aqui e rodar: docker compose restart
DLP_PASSWORD=troque-esta-senha

# Gerados uma vez na instalação: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DLP_SECRET_KEY=
DLP_UPLOAD_TOKEN=

# Horas até o arquivo baixado ser apagado da VPS
DLP_TTL_HOURS=6

DLP_DATA_DIR=/data

# Domínio público usado pelo Caddy (docker-compose.yml e Caddyfile leem esta var)
DLP_DOMAIN=dlp.seudominio.com

# Opcional: só para os testes de integração locais (marker "integration").
# GROQ_API_KEY=
